# Site-specific settings for the workflow shell scripts (template).
#
# Copy to config/site.env (gitignored) and adapt to your cluster:
#     cp config/site.example.env config/site.env
# Sourced by workflows/common/load_site_env.sh. Replace the /path/to/... placeholders.

# Python used on the login node to read config/paths.yaml (needs PyYAML)
CS2F_PYTHON=python3

# Conda shell hook (provides `conda activate` in batch jobs)
CS2F_CONDA_SH=/path/to/miniforge3/etc/profile.d/conda.sh

# Conda environment per workflow (environment name or prefix path).
# cardiomics_s2f must be installed in the AlphaGenome env: pip install -e .
CS2F_ENV_ALPHAGENOME_FT=alphagenome_ft
# Lean CPU-only env for the pretrained AlphaGenome API (workflows/alphagenome_api/):
# pip install -e ".[alphagenome]"
CS2F_ENV_ALPHAGENOME=alphagenome
CS2F_ENV_CHROMBPNET=chrombpnet

# SLURM settings added by cs2f_sbatch (leave empty to omit an option)
CS2F_SLURM_ACCOUNT=
CS2F_SLURM_CPU_PARTITION=
# High-memory partition (AlphaGenome API track matching and prediction need 1-2 TB)
CS2F_SLURM_BIGMEM_PARTITION=
CS2F_SLURM_GPU_PARTITION=
CS2F_SLURM_GPU_QOS=
# e.g. "gpu=H100|gpu=A100" (quote values containing |)
CS2F_SLURM_GPU_CONSTRAINT=
