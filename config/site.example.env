# Site-specific settings for the workflow shell scripts (template).
#
# Copy to config/site.env (gitignored) and adapt to your cluster:
#     cp config/site.example.env config/site.env
# Sourced by workflows/common/load_site_env.sh. Values below are the EMBL cluster setup.

# Conda shell hook (provides `conda activate` in batch jobs)
CS2F_CONDA_SH=/g/easybuild/x86_64/Rocky/8/haswell/software/Miniforge3/24.1.2-0/etc/profile.d/conda.sh

# Conda environment per workflow (environment name or prefix path)
CS2F_ENV_ALPHAGENOME_FT=/g/steinmetz/projects/variant2function_project/env/alphagenome_ft
CS2F_ENV_CHROMBPNET=/g/steinmetz/projects/variant2function_project/env/chrombpnet

# SLURM defaults used by the submit scripts
CS2F_SLURM_CPU_PARTITION=bigmem
CS2F_SLURM_GPU_PARTITION=gpu-training
CS2F_SLURM_QOS=high
