# HPC Cluster Logs (workflow logs and run lists: logs/<workflow>/)
logs/
*.out
*.err
*.log

# Large Data Files
*.h5
*.dat
*.textproto
*.bw
*.bam
*.parquet
*.narrowPeak
*.bed
input_data/metadata/GRCh38_gencode_release29_genome_fasta/*

# Local configuration and secrets (templates: config/*.example.*, .env.example)
config/paths.yaml
config/site.env
.env
# Data-specific files (only READMEs and *.example.* templates are tracked)
PROVENANCE.md
workflows/alphagenome_ft/configs/*
!workflows/alphagenome_ft/configs/README.md
!workflows/alphagenome_ft/configs/*.example.*
workflows/input_prep/configs/*
!workflows/input_prep/configs/README.md
!workflows/input_prep/configs/*.example.*

# Data, models and results live outside git (only the READMEs are tracked)
input_data/*
!input_data/README.md
models/*
!models/README.md
results/*
!results/README.md

# Python / Jupyter Artifacts
__pycache__/
*.pyc
*.egg-info/
/build/
/dist/
.ipynb_checkpoints/
.conda

# Documentation build output
docs/build/
docs/_build/

then/
DOCUMENTATION_GUIDE.md
.gemini/
