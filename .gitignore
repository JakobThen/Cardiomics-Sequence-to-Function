# HPC Cluster Logs (workflow logs and run lists: logs/<workflow>/)
logs/
*.out
*.err
*.log

# Large Data Files
*.h5
*.dat
*.textproto
*.bw
*.bam
*.parquet
*.narrowPeak
*.bed
input_data/metadata/GRCh38_gencode_release29_genome_fasta/*

# Local configuration and secrets (templates: config/*.example.*, .env.example)
config/paths.yaml
config/site.env
.env
# Group-specific run configs with cluster paths (see the READMEs in these folders)
workflows/alphagenome_ft/configs/*.yaml
workflows/input_prep/configs/cutntag_bams.txt

# Data, models and results live outside git (only the READMEs are tracked)
input_data/*
!input_data/README.md
models/*
!models/README.md
results/*
!results/README.md

# Python / Jupyter Artifacts
__pycache__/
*.pyc
*.egg-info/
/build/
/dist/
.ipynb_checkpoints/
.conda

#Documentation
docs/_build/

then/
DOCUMENTATION_GUIDE.md
.gemini/